{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "菲利多尔",
  "mainBinaryName": "philidor",
  "version": "0.6.0",
  "identifier": "io.github.aizhang453-hash.philidor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "菲利多尔",
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-" }
  }
}
